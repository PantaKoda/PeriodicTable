---
import Layout from '../layouts/Layout.astro'
import { categoryLabels, elements, type Category } from '../data/elements'
import '../data/element-context'
import { languageLabels } from '../data/i18n'
import '../styles/global.css'

const categories = Object.entries(categoryLabels) as [Category, string][]
const initial = elements.find((element) => element.number === 6)!
---

<Layout
  title="Periodic Table — Explore the Elements"
  description="An interactive, neo-brutalist periodic table with essential facts for all 118 chemical elements."
>
  <main class="page-shell">
    <section class="controls" aria-label="Table controls" id="table-controls">
      <label class="search-box">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <span class="sr-only" id="search-label">Search elements</span>
        <input id="element-search" type="search" aria-label="Search elements" placeholder="Search name, symbol, or number…" autocomplete="off" />
        <span id="search-count" aria-live="polite">118</span>
      </label>
      <div class="control-actions">
        <div class="language-switcher" role="group" aria-label="Language" id="language-switcher">
          {(Object.entries(languageLabels) as [string, string][]).map(([code, label]) => (
            <button
              type="button"
              class="language-button"
              data-language={code}
              aria-label={label}
              title={label}
              aria-pressed={code === 'en' ? 'true' : 'false'}
            >
              {code.toUpperCase()}
            </button>
          ))}
        </div>
        <button id="random-element" class="brutal-button" type="button">
          <span id="random-label">Surprise me</span> <span aria-hidden="true">↗</span>
        </button>
      </div>
    </section>

    <section class="element-inspector" aria-live="polite" aria-label="Selected element details" id="element-inspector">
      <div class:list={['inspector-symbol', `category-${initial.category}`]} id="inspector-symbol">
        <span id="inspector-number">{initial.number}</span>
        <strong id="inspector-symbol-text">{initial.symbol}</strong>
      </div>
      <div class="inspector-copy">
        <div class="inspector-title-row">
          <div>
            <p class="micro-label" id="current-element-label">CURRENT ELEMENT</p>
            <h2 id="inspector-name">{initial.name}</h2>
          </div>
          <div class="inspector-actions">
            <span class:list={['category-chip', `category-${initial.category}`]} id="inspector-category">
              {categoryLabels[initial.category]}
            </span>
            <button class="details-button" id="open-details" type="button">
              <span id="more-details-label">More details</span> <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
        <p class="element-fact" id="inspector-fact">{initial.fact}</p>
      </div>
      <dl class="inspector-stats">
        <div><dt id="atomic-mass-label">Atomic mass</dt><dd id="inspector-mass">{initial.mass}</dd></div>
        <div><dt id="group-label">Group</dt><dd id="inspector-group">{initial.group ?? '—'}</dd></div>
        <div><dt id="period-label">Period</dt><dd id="inspector-period">{initial.period}</dd></div>
        <div><dt id="phase-label">At 20 °C</dt><dd id="inspector-phase">{initial.phase}</dd></div>
      </dl>
    </section>

    <div class="table-scroll" tabindex="0" aria-label="Scrollable periodic table" id="table-scroll">
      <div class="periodic-table" id="periodic-table">
        <div class="series-label lanthanide-label" aria-hidden="true"><span>57–71</span><span id="lanthanides-label">Lanthanides</span></div>
        <div class="series-label actinide-label" aria-hidden="true"><span>89–103</span><span id="actinides-label">Actinides</span></div>
        <div class="series-marker lanthanide-marker" aria-hidden="true"><strong>57–71</strong><small>La–Lu</small></div>
        <div class="series-marker actinide-marker" aria-hidden="true"><strong>89–103</strong><small>Ac–Lr</small></div>

        {elements.map((element) => (
          <button
            type="button"
            class:list={[
              'element-card',
              `category-${element.category}`,
              { 'is-current': element.number === initial.number },
            ]}
            style={`--column:${element.column}; --row:${element.row}`}
            aria-label={`${element.name}, atomic number ${element.number}`}
            aria-pressed="false"
            data-number={element.number}
            data-symbol={element.symbol}
            data-name={element.name}
            data-mass={element.mass}
            data-category={element.category}
            data-category-label={categoryLabels[element.category]}
            data-group={element.group ?? '—'}
            data-period={element.period}
            data-phase={element.phase}
            data-fact={element.fact}
          >
            <span class="atomic-number">{element.number}</span>
            <strong>{element.symbol}</strong>
            <span class="element-name">{element.name}</span>
            <span class="atomic-mass">{element.mass}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="scroll-note" aria-hidden="true">← <span id="swipe-label">Swipe to explore the full table</span> →</p>

    <nav class="legend" aria-label="Filter elements by category" id="category-legend">
      {categories.map(([category, label]) => (
        <button type="button" class="legend-item" data-filter={category} aria-pressed="false">
          <span class:list={['legend-swatch', `category-${category}`]}></span><span class="legend-label">{label}</span>
        </button>
      ))}
      <button type="button" class="legend-clear" id="clear-filter" hidden>Show all</button>
    </nav>

    <footer>
      <p id="bracket-note">Atomic masses in brackets refer to the mass number of the longest-lived isotope.</p>
      <p><span id="built-for">Built for curious minds</span> <span aria-hidden="true">●</span> 2026</p>
    </footer>
  </main>

  <dialog class="details-dialog" id="element-details" aria-labelledby="details-name">
    <article class="details-panel">
      <header class:list={['details-header', `category-${initial.category}`]} id="details-header">
        <div class="details-identity">
          <span id="details-number">6</span>
          <strong id="details-symbol">C</strong>
          <div>
            <p id="details-category">Reactive nonmetal</p>
            <h2 id="details-name">Carbon</h2>
          </div>
        </div>
        <button class="details-close" id="close-details" type="button" aria-label="Close details">×</button>
      </header>
      <div class="details-content">
        <section class="context-section">
          <span class="context-icon" aria-hidden="true">⌁</span>
          <div><h3 id="occurrence-title">Occurrence in nature</h3><p id="details-occurrence"></p></div>
        </section>
        <section class="context-section">
          <span class="context-icon" aria-hidden="true">◇</span>
          <div><h3 id="native-title">Free form in nature</h3><p id="details-native"></p></div>
        </section>
        <section class="context-section">
          <span class="context-icon" aria-hidden="true">✦</span>
          <div><h3 id="biology-title">Biological role</h3><p id="details-biology"></p></div>
        </section>
        <section class="context-section">
          <span class="context-icon" aria-hidden="true">⚒</span>
          <div><h3 id="uses-title">Common uses</h3><p id="details-uses"></p></div>
        </section>
        <section class="details-sources">
          <div class="sources-heading">
            <h3 id="sources-title">Sources</h3>
            <span id="reviewed-date"></span>
          </div>
          <ul id="details-source-list"></ul>
        </section>
      </div>
    </article>
  </dialog>

  <script>
    import { elementContextByNumber } from '../data/element-context'
    import { contextSourceById, sourceUrl } from '../data/context-sources'
    import { elements } from '../data/elements'
    import {
      getElementFact,
      getElementName,
      languageLabels,
      localizedCategories,
      ui,
      type Language,
    } from '../data/i18n'

    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.element-card'))
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
    const languageButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-language]'))
    const search = document.querySelector<HTMLInputElement>('#element-search')!
    const searchCount = document.querySelector<HTMLElement>('#search-count')!
    const clearFilter = document.querySelector<HTMLButtonElement>('#clear-filter')!
    const inspectorSymbol = document.querySelector<HTMLElement>('#inspector-symbol')!
    const inspectorCategory = document.querySelector<HTMLElement>('#inspector-category')!
    const detailsHeader = document.querySelector<HTMLElement>('#details-header')!
    const detailsDialog = document.querySelector<HTMLDialogElement>('#element-details')!
    let activeFilter = ''
    let currentLanguage: Language = 'en'
    let currentCard = cards[5]
    let lockedCard: HTMLButtonElement | null = null

    const fields = {
      number: document.querySelector<HTMLElement>('#inspector-number')!,
      symbol: document.querySelector<HTMLElement>('#inspector-symbol-text')!,
      name: document.querySelector<HTMLElement>('#inspector-name')!,
      fact: document.querySelector<HTMLElement>('#inspector-fact')!,
      mass: document.querySelector<HTMLElement>('#inspector-mass')!,
      group: document.querySelector<HTMLElement>('#inspector-group')!,
      period: document.querySelector<HTMLElement>('#inspector-period')!,
      phase: document.querySelector<HTMLElement>('#inspector-phase')!,
    }

    const text = {
      searchLabel: document.querySelector<HTMLElement>('#search-label')!,
      random: document.querySelector<HTMLElement>('#random-label')!,
      currentElement: document.querySelector<HTMLElement>('#current-element-label')!,
      atomicMass: document.querySelector<HTMLElement>('#atomic-mass-label')!,
      group: document.querySelector<HTMLElement>('#group-label')!,
      period: document.querySelector<HTMLElement>('#period-label')!,
      phase: document.querySelector<HTMLElement>('#phase-label')!,
      lanthanides: document.querySelector<HTMLElement>('#lanthanides-label')!,
      actinides: document.querySelector<HTMLElement>('#actinides-label')!,
      swipe: document.querySelector<HTMLElement>('#swipe-label')!,
      clear: document.querySelector<HTMLElement>('#clear-filter')!,
      bracketNote: document.querySelector<HTMLElement>('#bracket-note')!,
      builtFor: document.querySelector<HTMLElement>('#built-for')!,
      moreDetails: document.querySelector<HTMLElement>('#more-details-label')!,
    }

    const detailFields = {
      number: document.querySelector<HTMLElement>('#details-number')!,
      symbol: document.querySelector<HTMLElement>('#details-symbol')!,
      category: document.querySelector<HTMLElement>('#details-category')!,
      name: document.querySelector<HTMLElement>('#details-name')!,
      occurrenceTitle: document.querySelector<HTMLElement>('#occurrence-title')!,
      occurrence: document.querySelector<HTMLElement>('#details-occurrence')!,
      nativeTitle: document.querySelector<HTMLElement>('#native-title')!,
      native: document.querySelector<HTMLElement>('#details-native')!,
      biologyTitle: document.querySelector<HTMLElement>('#biology-title')!,
      biology: document.querySelector<HTMLElement>('#details-biology')!,
      usesTitle: document.querySelector<HTMLElement>('#uses-title')!,
      uses: document.querySelector<HTMLElement>('#details-uses')!,
      sourcesTitle: document.querySelector<HTMLElement>('#sources-title')!,
      sourceList: document.querySelector<HTMLUListElement>('#details-source-list')!,
      reviewed: document.querySelector<HTMLElement>('#reviewed-date')!,
    }

    function showCard(card: HTMLButtonElement, scroll = false) {
      const data = card.dataset
      currentCard = card
      cards.forEach((item) => {
        item.classList.toggle('is-current', item === card)
      })

      fields.number.textContent = data.number ?? ''
      fields.symbol.textContent = data.symbol ?? ''
      fields.name.textContent = data.name ?? ''
      fields.fact.textContent = data.fact ?? ''
      fields.mass.textContent = data.mass ?? ''
      fields.group.textContent = data.group ?? ''
      fields.period.textContent = data.period ?? ''
      fields.phase.textContent = data.phaseLabel ?? data.phase ?? ''
      inspectorCategory.textContent = data.categoryLabel ?? ''

      const categoryClasses = Object.keys(localizedCategories.en).map((category) => `category-${category}`)
      inspectorSymbol.classList.remove(...categoryClasses)
      inspectorCategory.classList.remove(...categoryClasses)
      inspectorSymbol.classList.add(`category-${data.category}`)
      inspectorCategory.classList.add(`category-${data.category}`)

      if (scroll) card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' })
    }

    function lockCard(card: HTMLButtonElement, scroll = false) {
      lockedCard = card
      cards.forEach((item) => {
        const locked = item === card
        item.classList.toggle('is-selected', locked)
        item.setAttribute('aria-pressed', String(locked))
      })
      text.currentElement.textContent = ui[currentLanguage].lockedElement
      showCard(card, scroll)
    }

    function renderDetails(atomicNumber: number) {
      const element = elements[atomicNumber - 1]
      const context = elementContextByNumber[atomicNumber]
      const strings = ui[currentLanguage]
      detailFields.number.textContent = String(atomicNumber)
      detailFields.symbol.textContent = element.symbol
      detailFields.category.textContent = localizedCategories[currentLanguage][element.category]
      detailFields.name.textContent = getElementName(element, currentLanguage)
      const categoryClasses = Object.keys(localizedCategories.en).map((category) => `category-${category}`)
      detailsHeader.classList.remove(...categoryClasses)
      detailsHeader.classList.add(`category-${element.category}`)
      detailFields.occurrenceTitle.textContent = strings.occurrenceInNature
      detailFields.occurrence.textContent = context.naturalOccurrence.text[currentLanguage]
      detailFields.nativeTitle.textContent = strings.freeFormInNature
      detailFields.native.textContent = context.nativeOccurrence.text[currentLanguage]
      detailFields.biologyTitle.textContent = strings.biologicalRole
      detailFields.biology.textContent = context.biologicalRole.text[currentLanguage]
      detailFields.usesTitle.textContent = strings.commonUses
      detailFields.uses.textContent = context.commonUses.text[currentLanguage]
      detailFields.sourcesTitle.textContent = strings.sources

      const locale = currentLanguage === 'sv' ? 'sv-SE' : currentLanguage === 'el' ? 'el-GR' : 'en-GB'
      const reviewedDate = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(
        new Date(`${context.reviewedAt}T12:00:00Z`),
      )
      detailFields.reviewed.textContent = `${strings.reviewedOn}: ${reviewedDate}`

      const sourceIds = Array.from(
        new Set([
          ...context.naturalOccurrence.sourceIds,
          ...context.nativeOccurrence.sourceIds,
          ...context.biologicalRole.sourceIds,
          ...context.commonUses.sourceIds,
        ]),
      )
      detailFields.sourceList.replaceChildren(
        ...sourceIds.map((sourceId) => {
          const source = contextSourceById[sourceId]
          const item = document.createElement('li')
          const link = document.createElement('a')
          link.href = sourceUrl(source, atomicNumber)
          link.target = '_blank'
          link.rel = 'noreferrer'
          link.textContent = source.publisher
          const arrow = document.createElement('span')
          arrow.setAttribute('aria-hidden', 'true')
          arrow.textContent = ' ↗'
          link.append(arrow)
          item.append(link)
          return item
        }),
      )
    }

    function normalizeSearch(value: string) {
      return value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase()
    }

    function applyVisibility() {
      const query = normalizeSearch(search.value.trim())
      let matches = 0

      cards.forEach((card) => {
        const searchable = normalizeSearch(`${card.dataset.name} ${card.dataset.symbol} ${card.dataset.number}`)
        const matchesSearch = !query || searchable.includes(query)
        const matchesFilter = !activeFilter || card.dataset.category === activeFilter
        const matchesBoth = matchesSearch && matchesFilter
        card.classList.toggle('is-muted', !matchesBoth)
        if (matchesBoth) matches += 1
      })
      searchCount.textContent = String(matches)
      clearFilter.hidden = !activeFilter && !query
    }

    function setLanguage(language: Language) {
      currentLanguage = language
      const strings = ui[language]
      document.documentElement.lang = language
      document.title = strings.pageTitle
      document.querySelector<HTMLMetaElement>('meta[name="description"]')!.content = strings.description

      text.searchLabel.textContent = strings.searchLabel
      search.setAttribute('aria-label', strings.searchLabel)
      search.placeholder = strings.searchPlaceholder
      text.random.textContent = strings.surprise
      text.currentElement.textContent = lockedCard ? strings.lockedElement : strings.currentElement
      text.atomicMass.textContent = strings.atomicMass
      text.group.textContent = strings.group
      text.period.textContent = strings.period
      text.phase.textContent = strings.at20
      text.lanthanides.textContent = strings.lanthanides
      text.actinides.textContent = strings.actinides
      text.swipe.textContent = strings.swipe
      text.clear.textContent = strings.showAll
      text.bracketNote.textContent = strings.bracketNote
      text.builtFor.textContent = strings.builtFor
      text.moreDetails.textContent = strings.moreDetails
      document.querySelector('#close-details')!.setAttribute('aria-label', strings.closeDetails)

      document.querySelector('#table-controls')!.setAttribute('aria-label', strings.tableControls)
      document.querySelector('#element-inspector')!.setAttribute('aria-label', strings.selectedDetails)
      document.querySelector('#table-scroll')!.setAttribute('aria-label', strings.scrollableTable)
      document.querySelector('#category-legend')!.setAttribute('aria-label', strings.filterElements)
      document.querySelector('#language-switcher')!.setAttribute('aria-label', strings.language)

      cards.forEach((card) => {
        const element = elements[Number(card.dataset.number) - 1]
        const name = getElementName(element, language)
        const categoryLabel = localizedCategories[language][element.category]
        const fact = getElementFact(element, language)
        const phaseLabel = strings.phases[element.phase]
        card.dataset.name = name
        card.dataset.categoryLabel = categoryLabel
        card.dataset.fact = fact
        card.dataset.phaseLabel = phaseLabel
        card.querySelector<HTMLElement>('.element-name')!.textContent = name
        card.setAttribute('aria-label', `${name}, ${strings.atomicNumber} ${element.number}`)
      })

      filters.forEach((filter) => {
        const category = filter.dataset.filter as keyof typeof localizedCategories.en
        filter.querySelector<HTMLElement>('.legend-label')!.textContent = localizedCategories[language][category]
      })

      languageButtons.forEach((button) => {
        const code = button.dataset.language as Language
        button.setAttribute('aria-pressed', String(code === language))
        button.setAttribute('aria-label', languageLabels[code])
      })

      showCard(currentCard)
      if (detailsDialog.open) renderDetails(Number(currentCard.dataset.number))
      applyVisibility()
      localStorage.setItem('periodic-table-language', language)
    }

    cards.forEach((card) => {
      card.addEventListener('pointerenter', () => {
        if (!lockedCard) showCard(card)
      })
      card.addEventListener('focus', () => {
        if (!lockedCard) showCard(card)
      })
      card.addEventListener('click', () => lockCard(card))
    })

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const nextFilter = filter.dataset.filter ?? ''
        activeFilter = activeFilter === nextFilter ? '' : nextFilter
        filters.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.filter === activeFilter)))
        applyVisibility()
      })
    })

    languageButtons.forEach((button) => {
      button.addEventListener('click', () => setLanguage(button.dataset.language as Language))
    })

    search.addEventListener('input', () => {
      applyVisibility()
      const firstMatch = cards.find((card) => !card.classList.contains('is-muted'))
      if (!lockedCard && firstMatch && search.value.trim()) showCard(firstMatch, true)
    })

    clearFilter.addEventListener('click', () => {
      activeFilter = ''
      search.value = ''
      filters.forEach((item) => item.setAttribute('aria-pressed', 'false'))
      applyVisibility()
      search.focus()
    })

    document.querySelector<HTMLButtonElement>('#random-element')!.addEventListener('click', () => {
      const visibleCards = cards.filter((card) => !card.classList.contains('is-muted'))
      const pool = visibleCards.length ? visibleCards : cards
      const randomCard = pool[Math.floor(Math.random() * pool.length)]
      lockCard(randomCard, true)
      randomCard.focus({ preventScroll: true })
    })

    document.querySelector<HTMLButtonElement>('#open-details')!.addEventListener('click', () => {
      renderDetails(Number(currentCard.dataset.number))
      detailsDialog.showModal()
      document.body.classList.add('has-open-dialog')
    })

    document.querySelector<HTMLButtonElement>('#close-details')!.addEventListener('click', () => detailsDialog.close())
    detailsDialog.addEventListener('click', (event) => {
      if (event.target === detailsDialog) detailsDialog.close()
    })
    detailsDialog.addEventListener('close', () => document.body.classList.remove('has-open-dialog'))

    const savedLanguage = localStorage.getItem('periodic-table-language')
    if (savedLanguage === 'sv' || savedLanguage === 'el') setLanguage(savedLanguage)
  </script>
</Layout>
